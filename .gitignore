# OS
.DS_Store

# Editor / IDE (configuracion local privada)
.vscode/
.idea/
*.code-workspace
.claude/
# Se ignora el contenido de .github (no el directorio: si se excluye el
# directorio, git no desciende y el `!` de abajo no puede reincluir nada).
.github/*
!.github/workflows/

# Entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt

# Logs y temporales
*.log
tmp/
temp/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node/Web comunes
node_modules/
dist/
build/
coverage/

# misc
backup/

# Datos reales del organigrama: nunca se versionan ni se despliegan.
# `data/org.yaml` versionado es la estructura ficticia de demo.
data/org.local.yaml